process {
    executor = 'slurm'
    queue    = 'smp'
    withLabel: process_gpu {
        queue          = 'gpu'
        clusterOptions = "-A ${System.getenv('SBATCH_ACCOUNT')} --gpus=h100_1g.12gb:1"
    }
    // CONTAINER_DIR and CELLBENDER_PRIORS are set by run_pipeline.py; the image is built by setup.sh
    withName: '.*:CELLBENDER_REMOVEBACKGROUND' {
        // the module's image (CellBender 0.3.2) does not run on H100 GPUs
        container = "${System.getenv('CONTAINER_DIR')}/cellbender-0.4.0-gpu.sif"
        memory    = 96.GB
        // the priors of each sample from cellbender_priors.tsv (scdownstream passes only expected_cells)
        ext.args  = {
            def lines = new File(System.getenv('CELLBENDER_PRIORS')).readLines()
            def header = lines[0].split('\t') as List
            def row = lines.drop(1).collect { line -> line.split('\t') }.find { fields -> fields[0] == meta.id }
            [
                "--epochs ${params.cellbender_epochs}",
                "--expected-cells ${row[header.indexOf('expected_cells')]}",
                "--total-droplets-included ${row[header.indexOf('total_droplets')]}",
                '--fpr 0.0',
            ].join(' ')
        }
    }
    withName: '.*:QC_REPORT' {
        // loads the whole merged object; the module default (12 GB) was too little for 9 samples
        memory = 48.GB
    }
    withName: '.*:SCANPY_PAGA' {
        ext.when = false
    }
}

executor {
    name            = 'slurm'
    queueSize       = 50
    submitRateLimit = '10 sec'
}
