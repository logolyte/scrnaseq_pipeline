process {
    executor = 'slurm'
    queue = 'smp'
    withLabel: 'process_high' {
        cpus = 64
        memory = 72.GB
    }
    // Cell Ranger-like cell calling and UMI handling. No --twopassMode Basic: it breaks
    // GeneFull_Ex50pAS (https://github.com/alexdobin/STAR/issues/1533)
    withName: '.*:STAR_ALIGN' {
        ext.args = {
            [
                '--readFilesCommand zcat',
                '--runDirPerm All_RWX',
                '--outSAMtype BAM SortedByCoordinate',
                "--limitBAMsortRAM ${task.memory.toBytes()}",
                '--soloCellFilter EmptyDrops_CR',
                '--soloUMIdedup 1MM_CR',
                '--soloUMIfiltering MultiGeneUMI_CR',
            ].join(' ')
        }
    }
    // only h5ad files, no RDS
    withName: 'ANNDATAR_CONVERT' {
        ext.when = false
    }
}

executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10 sec'
}

// scrnaseq's schema does not list GeneFull_Ex50pAS
validation {
    ignoreParams = ['star_feature']
}

