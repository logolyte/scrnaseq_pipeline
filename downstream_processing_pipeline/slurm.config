process {
    executor = 'slurm'
    queue = 'smp'
    withLabel: 'process_high' {
        cpus = 64
        memory = 72.GB
    }
    withLabel: 'process_gpu' {
        queue          = 'gpu'
        clusterOptions = "-A ${System.getenv('SBATCH_ACCOUNT')} --gpus=h100_1g.12gb:1"
    }
    // Images built by setup.sh from containers/ (CONTAINER_DIR is set in pipeline.conf)
    withName: '.*:CELLBENDER_REMOVEBACKGROUND' {
        // The module's GPU image (CellBender 0.3.2) does not run on H100 GPUs
        container = "${System.getenv('CONTAINER_DIR')}/cellbender-0.4.0-gpu.sif"
        cpus      = 6
        memory    = 96.GB
        time      = 4.h
        // --expected-cells and --total-droplets-included per sample, chosen by
        // cellbender_priors.py when the samplesheet is built (scdownstream itself
        // only passes expected_cells on to CellBender)
        ext.args  = {
            def priorsFile = new File(System.getenv('CELLBENDER_PRIORS'))
            def lines = priorsFile.readLines().findAll { line -> line.trim() }
            def header = lines[0].split('\t') as List
            def row = lines.drop(1).collect { line -> line.split('\t') }.find { fields -> fields[0] == meta.id }
            if (row == null) {
                throw new IllegalStateException("no CellBender priors for sample ${meta.id} in ${priorsFile}; rebuild the samplesheet")
            }
            [
                "--epochs ${params.cellbender_epochs}",
                "--expected-cells ${row[header.indexOf('expected_cells')]}",
                "--total-droplets-included ${row[header.indexOf('total_droplets')]}",
                "--fpr 0.0"
            ].join(' ')
        }
    }
    withName: '.*:QC_REPORT' {
        // Loads the whole merged object: 12 GB (the module default) was too little
        // for 9 WT1 samples (3.6 GB h5ad; Lmx1b with 6 samples needed 9.4 GB)
        memory = 48.GB
    }
    withName: '.*:SCDBLFINDER' {
        // The module's scDblFinder 1.24.0 calls 2-3x too few doublets with
        // xgboost >= 3.1 (nf-core/scdownstream#382); 1.24.10 fixes this
        container = "${System.getenv('CONTAINER_DIR')}/scdblfinder-1.24.10.sif"
    }
    withName: '.*:SCANPY_PAGA' {
        ext.when = false  // Skip PAGA in pipeline since it is often not necessary
    }

}

executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10 sec'
}
