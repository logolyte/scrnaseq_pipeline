process {
    executor = 'slurm'
    queue = 'smp'
    withLabel: 'process_high' {
        cpus = 64
        memory = 72.GB
    }
    withLabel: 'process_gpu' {
        queue          = 'gpu'
        clusterOptions = '-A ag-beyer --gpus=h100_1g.12gb:1'
    }
    withName: '.*:CELLBENDER_REMOVEBACKGROUND' {
        container = '/home/lsundin/podocyte_damage_trajectories/environments/cellbender-0.4.0-gpu.sif'
        cpus      = 6
        memory    = 96.GB
        time      = 4.h
        ext.args  = { [
            "--epochs ${params.cellbender_epochs}",
            meta.expected_cells ? "--expected-cells ${meta.expected_cells}" : "",
            meta.expected_cells ? "--total-droplets-included ${(meta.expected_cells as int) + 20000}" : "",
            "--fpr 0.0"
        ].join(' ').trim() }
    }
}

executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10 sec'
}
