Bootstrap: docker
From: pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime

# CellBender for CELLBENDER_REMOVEBACKGROUND of nf-core/scdownstream. The module's GPU
# image (CellBender 0.3.2) does not run on H100 GPUs; 0.4.0 gives the same results.

%files
    lock.txt /opt/recipe/lock.txt

%post
    if [ -s /opt/recipe/lock.txt ]; then
        pip install --no-cache-dir -c /opt/recipe/lock.txt cellbender==0.4.0 torch==2.4.1
    else
        pip install --no-cache-dir cellbender==0.4.0 torch==2.4.1
    fi
    python -c "import torch; assert torch.__version__.startswith('2.4.1'), torch.__version__"

# Prints the exact package list; setup.sh saves it as lock.txt after the first build
%apprun lock
    exec /opt/conda/bin/pip list --format=freeze
