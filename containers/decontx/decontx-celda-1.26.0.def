Bootstrap: docker
From: community.wave.seqera.io/library/bioconductor-anndatar_bioconductor-celda_bioconductor-rhdf5_bioconductor-singlecellexperiment:195bce13eb18b882

# decontX for preprocessing/4_velocity_decontx/ (ambient correction of the velocyto
# layers). The base is the image of nf-core/scdownstream's CELDA_DECONTX module
# at the pinned commit (Seqera Containers tag, content-addressed), so the
# velocyto layers are corrected with the same R and celda as the main counts.
# Nothing is installed; the build only checks the versions.
#
# setup.sh copies lock.txt to /opt/recipe; this recipe does not need it, the
# tag already fixes every package.

%files
    lock.txt /opt/recipe/lock.txt

%post
    /opt/wave/.pixi/envs/default/bin/Rscript -e 'stopifnot(packageVersion("celda") == "1.26.0", packageVersion("anndataR") == "1.0.2")'

%environment
    export PATH=/opt/wave/.pixi/envs/default/bin:$PATH

# Prints the exact package list; setup.sh saves it as lock.txt after the first build
%apprun lock
    exec ls /opt/wave/.pixi/envs/default/conda-meta | grep '\.json$' | sed 's/\.json$//' | sort
