process {
    executor = 'slurm'
    queue = 'smp'
    clusterOptions = '-A ag-beyer'
    withLabel: 'process_high' {
        cpus = 64
        memory = 72.GB
    }
    // Custom STAR parameters
    withName: '.*:STAR_ALIGN' {
        ext.args = {
            [
                '--readFilesCommand zcat',
                '--runDirPerm All_RWX',
                '--outWigType bedGraph',
                '--outSAMtype BAM SortedByCoordinate',
                "--limitBAMsortRAM ${task.memory.toBytes()}",
                '--soloCellFilter EmptyDrops_CR', // Run emptydrops instead of default filtering based on quantiles, does not work for slide-seq
                '--soloUMIdedup 1MM_CR', // Use Cellranger's deduplication method
                '--soloUMIfiltering MultiGeneUMI_CR', // Use MultiGeneUMI like in Cellranger
                '--soloMultiMappers EM' // Use expectation maximization for multimappers
            ].join(' ')
        }
    }
    // Skip RDS conversion, only make h5ad files
    withName: 'ANNDATAR_CONVERT' {
        ext.when = false
    }
    // Cellbender parameters
    withName: 'CELLBENDER_REMOVEBACKGROUND' {
        ext.use_gpu    = true
        ext.args = '--fpr 0.01 0.05 0.1 --expected-cells 10000 --total-droplets-included 50000'
        queue          = 'gpu'
        clusterOptions = '-A ag-beyer --gpus=h100_1g.12gb:1'
        cpus           = 8
        memory         = 64.GB
        time           = 8.h
    }
}

// Due to a STAR bug --twopassMode Basic has to be dropped from ext.args to STAR_ALIGN when using the ex50pas feature: https://github.com/alexdobin/STAR/issues/1533

executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10 sec'
}

// Bypass the check for which features STAR will generate, allows for getting all three of Gene, GeneFull and Velocyto
validation {
    ignoreParams = ['star_feature']
}

