// nf-core/fetchngs on our Slurm cluster; the command is in README.md
process {
    executor = 'slurm'

    // NCBI answers 429 (too many requests) when several GSEs are resolved at once
    withName: SRA_IDS_TO_RUNINFO {
        maxForks = 1
    }

    // prefetch skips runs above 20 GB by default
    withName: SRATOOLS_PREFETCH {
        ext.args      = '--max-size u'
        // the cluster downloads about 350 MB/s in total; 30 downloads get about 10 MB/s each
        maxForks      = 30
        // a download sometimes stalls; 6 h fits about 200 GB at 10 MB/s
        time          = 6.h
        // after the last retry the running downloads finish instead of being killed
        maxRetries    = 3
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
    }
}
