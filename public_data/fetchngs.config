// nf-core/fetchngs on our Slurm cluster; the command is in README.md
process {
    executor = 'slurm'

    // prefetch skips runs above 20 GB by default
    withName: SRATOOLS_PREFETCH {
        ext.args = '--max-size u'
        // the cluster downloads about 350 MB/s in total; 30 downloads get about 10 MB/s each
        maxForks = 30
        time = 12.h
    }
}
